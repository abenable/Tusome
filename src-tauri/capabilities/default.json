{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "os:default",
    "process:default",
    "dialog:allow-save",
    "core:window:allow-set-fullscreen",
    "core:webview:allow-set-webview-zoom"
  ]
}
