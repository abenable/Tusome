{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tusome",
  "version": "1.0.2",
  "identifier": "ug.tusome",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run fetch:sims && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tusome",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://*.githubusercontent.com; frame-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/tusome/content/**", "$RESOURCE/content/**"]
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:tusome.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3QTVFMjk1MUUzRjdENUYKUldSZmZUOGVsZUtsRjd3bTNBSzNMSUUyb1pWM2hBZTdDeldxVkVKbzZ2WjdmcVYzZWZKS3JHMzgK",
      "endpoints": ["https://github.com/abenable/Tusome/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "../content/": "content/" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
