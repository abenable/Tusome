# Logs — autobuild transcripts are regenerable; keep the .md reports
*.log

# Dependencies / build output
node_modules
dist
dist-ssr
*.local

# Tauri
src-tauri/target

# Tusome signing keypair — the minisign keypair lives in ~/.tusome (outside the
# repo), but these patterns are defensive so no key ever lands in a commit.
*.key
*.key.pub
*.key.pw
dev-keys/

# Generated router tree — regenerated by the TanStack router-plugin on
# `vite dev`/`vite build`; COMMITTED so a fresh clone + CI can typecheck
# before any Vite run writes it (the plugin only generates it during dev/build).
# (deliberately not gitignored — see the CI fix in commit history.)

# Autobuild pid files (junk)
*.pid

# Editor directories and files
.vscode/
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.opencode/
DESIGN.md

# PhET sim artifacts — vendored, downloaded by scripts/fetch-phet-sims.sh
content/sims/*.html
public/Biology_Syllabus_compressed.pdf
